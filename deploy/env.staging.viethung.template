# CleverSchool STAGING — copy: cp env.staging.viethung.template .env
# Thư mục VPS: /opt/cleverschool-staging/deploy
# ĐỔI mật khẩu/JWT bên dưới trước khi deploy — không commit file .env

STACK_NAME=csstaging
API_DOMAIN=https://api-staging.viethung.uk
# URL gốc để trả link ảnh/video sau upload (không thêm /api)
APP_FULL_URL=https://api-staging.viethung.uk
FRONTEND_URL=https://staging.viethung.uk
ALLOW_ORIGINS=https://staging.viethung.uk,https://viethung.uk,http://localhost:3000

POSTGRES_DB=lms_db_staging
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change_me_staging_db
REDIS_PASSWORD=change_me_staging_redis
JWT_SECRET=change_me_staging_jwt_min_32_chars

RUN_MIGRATIONS=true
ENABLE_SWAGGER=false
APP_DEBUG=false
REDIS_ENABLED=true
REDIS_DB=0

ENABLE_DASHBOARD_JOBS=false

# Cloudflare R2 (media ảnh/video — khuyến nghị khi đã dùng Cloudflare)
# Tạo bucket + API token trên Cloudflare Dashboard → R2
AWS_BUCKET=cleverschool-staging
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# URL public để FE hiển thị file (custom domain R2 hoặc pub-xxx.r2.dev)
AWS_URL=https://media-staging.viethung.uk
# Local dev không có R2: MEDIA_DISK=public + APP_FULL_URL=http://localhost:8080
