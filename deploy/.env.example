# Dùng env.dev.example hoặc env.staging.example cho từng môi trường.
# Dev:  API_DOMAIN=https://api-dev.viethung.uk
# Staging: API_DOMAIN=https://api-staging.viethung.uk

STACK_NAME=csdev
API_DOMAIN=https://api-dev.viethung.uk
FRONTEND_URL=https://your-app.vercel.app
ALLOW_ORIGINS=https://your-app.vercel.app

# === Docker image (CI ghi đè khi deploy) ===
# API_IMAGE=ghcr.io/<owner>/cleverschool-api:latest

# === PostgreSQL (volume postgres_data) ===
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change_me_strong_password

# === Redis ===
REDIS_PASSWORD=change_me_redis_password
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# === App secrets ===
JWT_SECRET=change_me_jwt_min_32_chars
MASTER_PASSWORD=
ENABLE_SWAGGER=false
APP_DEBUG=false
RUN_MIGRATIONS=true

# === Dashboard / S3 (tùy chọn — MVP VPS thường để false / trống) ===
ENABLE_DASHBOARD_JOBS=false
# AWS_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# === SMTP (tùy chọn) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=CleverSchool
