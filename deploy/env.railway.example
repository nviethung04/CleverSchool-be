# Dán vào Railway → service api → Variables → Raw Editor
# Đổi tên service Postgres/Redis nếu khác (reference ${{ServiceName.VAR}}).
# Docs: https://docs.railway.com/guides/variables
#       https://docs.railway.com/guides/docker-compose

# --- Reference từ database managed (private network) ---
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_ENABLED=true

# --- Public URL API (Railway tự điền domain) ---
API_DOMAIN=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_FULL_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# --- Frontend Vercel ---
FRONTEND_URL=https://your-app.vercel.app
ALLOW_ORIGINS=https://your-app.vercel.app

# --- Secrets (đổi hết, không commit giá trị thật) ---
JWT_SECRET=change_me_jwt_min_32_chars
MASTER_PASSWORD=

RUN_MIGRATIONS=true
ENABLE_SWAGGER=false
APP_DEBUG=false

# --- SMTP (tuỳ chọn) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=CleverSchool
