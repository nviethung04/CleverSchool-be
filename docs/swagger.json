                    }
                },
                "overall_score": {
                    "description": "Điểm tổng (0-10)",
                    "type": "number"
                },
                "pronunciation_score": {
                    "description": "Điểm phát âm",
                    "type": "number"
                },
                "strengths": {
                    "description": "Điểm mạnh",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "transcript": {
