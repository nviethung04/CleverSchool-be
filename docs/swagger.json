        "services.WritingGradeResult": {
            "type": "object",
            "properties": {
                "content_score": {
                    "description": "Điểm nội dung",
                    "type": "number"
                },
                "feedback": {
                    "description": "Nhận xét chi tiết",
                    "type": "string"
                },
                "grammar_score": {
                    "description": "Điểm ngữ pháp",
                    "type": "number"
                },
                "improvements": {
                    "description": "Cần cải thiện",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "organization_score": {
                    "description": "Điểm tổ chức bài",
                    "type": "number"
                },
                "overall_score": {
                    "description": "Điểm tổng (0-10)",
                    "type": "number"
                },
                "strengths": {
                    "description": "Điểm mạnh",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "vocabulary_score": {
                    "description": "Điểm từ vựng",
                    "type": "number"
                }
            }
