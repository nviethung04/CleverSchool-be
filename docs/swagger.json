                    "description": "Điểm nội dung",
                    "type": "number"
                },
                "feedback": {
                    "description": "Nhận xét chi tiết",
                    "type": "string"
                },
                "improvements": {
                    "description": "Cần cải thiện",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "overall_score": {
                    "description": "Điểm tổng (0-10)",
                    "type": "number"
                },
                "presentation_score": {
                    "description": "Điểm trình bày",
                    "type": "number"
                },
                "recognized_text": {
                    "description": "Text nhận diện được từ ảnh (nếu có)",
                    "type": "string"
                },
                "strengths": {
                    "description": "Điểm mạnh",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "services.SpeakingGradeResult": {
            "type": "object",
            "properties": {
                "feedback": {
                    "description": "Nhận xét chi tiết",
