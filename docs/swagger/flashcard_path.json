{
    "/api/manage/flashcard/lessons/{lessonId}/vocabularies": {
        "get": {
            "security": [
                {
                    "BearerAuth": []
                }
            ],
            "description": "Get flashcards for studying with student progress and filtering",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Flashcard - Study"
            ],
            "summary": "Get flashcards for lesson",
            "parameters": [
                {
                    "type": "integer",
                    "description": "Lesson ID",
                    "name": "lessonId",
                    "in": "path",
                    "required": true
                },
                {
                    "type": "boolean",
                    "default": true,
                    "description": "Include student progress data",
                    "name": "include_progress",
                    "in": "query"
                },
                {
                    "type": "array",
                    "items": {
                        "enum": [
                            "new",
                            "learning",
                            "known",
                            "mastered"
                        ],
                        "type": "string"
                    },
                    "collectionFormat": "csv",
                    "description": "Filter by learning status",
                    "name": "status",
                    "in": "query"
                },
                {
                    "type": "boolean",
                    "default": false,
                    "description": "Shuffle the cards",
                    "name": "shuffle",
                    "in": "query"
                }
            ],
            "responses": {
                "200": {
                    "description": "OK",
                    "schema": {
                        "type": "object"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "type": "object"
                    }
                },
                "404": {
                    "description": "Not Found",
                    "schema": {
                        "type": "object"
                    }
                },
                "500": {
                    "description": "Internal Server Error",
                    "schema": {
                        "type": "object"
                    }
                }
            }
        },
        "post": {
            "security": [
                {
                    "BearerAuth": []
                }
            ],
            "description": "Add multiple vocabularies to a lesson",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Flashcard - Lesson"
            ],
            "summary": "Add vocabularies to lesson",
            "parameters": [
                {
                    "type": "integer",
                    "description": "Lesson ID",
                    "name": "lessonId",
                    "in": "path",
                    "required": true
                },
                {
                    "description": "Vocabularies to add",
                    "name": "vocabularies",
                    "in": "body",
                    "required": true,
                    "schema": {
                        "$ref": "#/definitions/requests.AddVocabulariesToLessonRequest"
                    }
                }
            ],
            "responses": {
                "201": {
                    "description": "Created",
                    "schema": {
                        "type": "object"
                    }
                },
                "400": {
                    "description": "Bad Request",
                    "schema": {
                        "type": "object"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "type": "object"
                    }
                },
                "404": {
                    "description": "Not Found",
                    "schema": {
                        "type": "object"
                    }
                },
                "500": {
                    "description": "Internal Server Error",
                    "schema": {
                        "type": "object"
                    }
                }
            }
        }
    },
