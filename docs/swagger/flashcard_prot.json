    "CreateVocabularyRequest": {
        "type": "object",
        "properties": {
            "word": {
                "type": "string",
                "description": "The vocabulary word",
                "example": "hello"
            },
            "phonetic": {
                "type": "string",
                "description": "Phonetic transcription",
                "example": "/həˈloʊ/"
            },
            "translation": {
                "type": "string",
                "description": "Translation in native language",
                "example": "xin chào"
            },
            "definition": {
                "type": "string",
                "description": "Definition of the word"
            },
            "part_of_speech": {
                "type": "string",
                "enum": [
                    "noun",
                    "verb",
                    "adjective",
                    "adverb",
                    "pronoun",
                    "preposition",
                    "conjunction",
                    "interjection"
                ]
            },
            "level": {
                "type": "string",
                "enum": [
                    "beginner",
                    "intermediate",
                    "advanced"
                ],
                "default": "beginner"
            },
            "tags": {
                "type": "string",
                "description": "Comma-separated tags"
            },
            "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "default": 1
            },
            "frequency": {
                "type": "integer",
                "default": 0
            },
            "word_audio_id": {
                "type": "integer",
                "format": "int64",
                "nullable": true,
                "description": "ID of word pronunciation audio file"
            },
            "image_id": {
                "type": "integer",
                "format": "int64",
                "nullable": true,
                "description": "ID of illustration image"
            },
            "example_audio_id": {
                "type": "integer",
                "format": "int64",
                "nullable": true,
                "description": "ID of example sentence audio file"
            },
            "example_sentence": {
                "type": "string",
                "description": "Example sentence using the word"
            },
            "example_translation": {
                "type": "string",
                "description": "Translation of example sentence"
            }
        },
        "required": [
            "word",
            "translation"
        ]
    },
