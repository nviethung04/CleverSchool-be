    "PronunciationAssessmentResponse": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "example": true
            },
            "message": {
                "type": "string",
                "example": "Pronunciation assessed successfully"
            },
            "data": {
                "type": "object",
                "properties": {
                    "vocabulary_id": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "score": {
                        "type": "number",
                        "format": "float",
                        "description": "Pronunciation score (0-100)",
                        "example": 87.5
                    },
                    "feedback": {
                        "type": "string",
                        "description": "Pronunciation feedback",
                        "example": "Good pronunciation! Try to emphasize the 'o' sound more."
                    },
                    "accuracy": {
                        "type": "number",
                        "format": "float",
                        "description": "Pronunciation accuracy percentage",
                        "example": 92.3
                    },
                    "mistakes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "phoneme": {
                                    "type": "string",
                                    "example": "oʊ"
                                },
                                "expected": {
                                    "type": "string",
                                    "example": "/oʊ/"
                                },
                                "actual": {
                                    "type": "string",
                                    "example": "/ɔː/"
                                },
                                "confidence": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 0.75
                                }
                            }
                        }
                    }
                }
            }
        }
    },
