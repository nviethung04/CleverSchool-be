{
    "VocabularyDTO": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "format": "int64",
                "description": "Vocabulary ID"
            },
            "word": {
                "type": "string",
                "description": "The vocabulary word",
                "example": "hello"
            },
            "phonetic": {
                "type": "string",
                "description": "Phonetic transcription",
                "example": "/həˈloʊ/"
            },
            "translation": {
                "type": "string",
                "description": "Translation in native language",
                "example": "xin chào"
            },
            "definition": {
                "type": "string",
                "description": "Definition of the word",
                "example": "A greeting used when meeting someone"
            },
            "part_of_speech": {
                "type": "string",
                "description": "Part of speech",
                "enum": [
                    "noun",
                    "verb",
                    "adjective",
                    "adverb",
                    "pronoun",
                    "preposition",
                    "conjunction",
                    "interjection"
                ],
                "example": "interjection"
            },
            "level": {
                "type": "string",
                "enum": [
                    "beginner",
                    "intermediate",
                    "advanced"
                ],
                "description": "Difficulty level",
                "example": "beginner"
            },
            "tags": {
                "type": "string",
                "description": "Comma-separated tags",
                "example": "greeting,basic,daily"
            },
            "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Difficulty rating (1-5)",
                "example": 2
            },
            "frequency": {
                "type": "integer",
                "description": "Usage frequency",
                "example": 100
            },
            "word_audio": {
                "$ref": "#/components/schemas/MediaDTO"
            },
            "image": {
                "$ref": "#/components/schemas/MediaDTO"
            },
            "example_audio": {
                "$ref": "#/components/schemas/MediaDTO"
            },
            "example_sentence": {
                "type": "string",
                "description": "Example sentence",
                "example": "Hello, how are you today?"
            },
            "example_translation": {
                "type": "string",
                "description": "Translation of example sentence",
                "example": "Xin chào, hôm nay bạn khỏe không?"
            },
            "created_at": {
                "type": "string",
                "format": "date-time"
            },
            "updated_at": {
                "type": "string",
                "format": "date-time"
            }
        },
        "required": [
            "id",
            "word",
            "translation"
        ]
    },
    "MediaDTO": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "format": "int64"
            },
            "file_name": {
                "type": "string",
                "example": "hello.mp3"
            },
            "file_path": {
                "type": "string",
                "example": "/audio/vocabulary/"
            },
            "full_path": {
                "type": "string",
                "example": "/audio/vocabulary/hello.mp3"
            },
            "file_type": {
                "type": "string",
                "example": "audio/mpeg"
            },
            "file_size": {
                "type": "integer",
                "format": "int64",
                "example": 524288
            },
            "url": {
                "type": "string",
                "example": "https://cdn.example.com/audio/vocabulary/hello.mp3"
            }
        }
    },
    "StudentVocabularyProgressDTO": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "format": "int64"
            },
            "student_id": {
                "type": "integer",
                "format": "int64"
            },
            "vocabulary_id": {
                "type": "integer",
                "format": "int64"
            },
            "lesson_id": {
                "type": "integer",
                "format": "int64"
            },
            "status": {
                "type": "string",
                "enum": [
                    "new",
                    "learning",
                    "known",
                    "mastered"
                ],
                "description": "Learning status",
                "example": "learning"
            },
            "is_known": {
                "type": "boolean",
                "description": "Student marked as known",
                "example": false
            },
            "study_count": {
                "type": "integer",
                "description": "Number of study sessions",
                "example": 5
            },
            "correct_count": {
                "type": "integer",
                "description": "Number of correct attempts",
                "example": 3
            },
            "last_studied_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
            },
            "mastered_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
            },
            "pronunciation_score": {
                "type": "number",
                "format": "float",
                "minimum": 0,
                "maximum": 100,
                "nullable": true,
                "example": 85.5
            },
            "best_pronunciation_score": {
                "type": "number",
                "format": "float",
                "minimum": 0,
                "maximum": 100,
                "nullable": true,
                "example": 92.3
            },
            "pronunciation_attempts": {
                "type": "integer",
                "description": "Number of pronunciation attempts",
                "example": 8
            },
            "vocabulary": {
                "$ref": "#/components/schemas/VocabularyDTO"
            }
        }
    },
    "LessonVocabularyDTO": {
        "type": "object",
