{
    "ChatMessage": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "description": "ID của tin nhắn",
                "example": 123
            },
            "content": {
                "type": "string",
                "description": "Nội dung tin nhắn",
                "example": "Hello everyone!"
            },
            "user_id": {
                "type": "integer",
                "description": "ID của người gửi",
                "example": 485
            },
            "user_name": {
                "type": "string",
                "description": "Tên người gửi",
                "example": "John Doe"
            },
            "course_id": {
                "type": "integer",
                "description": "ID của course",
                "example": 102
            },
            "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian tạo",
                "example": "2025-09-11T16:50:00Z"
            },
            "updated_at": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian cập nhật",
                "example": "2025-09-11T16:50:00Z"
            },
            "is_pinned": {
                "type": "boolean",
                "description": "Tin nhắn có được pin không",
                "example": false
            },
            "replies_count": {
                "type": "integer",
                "description": "Số lượng replies",
                "example": 3
            },
            "medias": {
                "type": "array",
                "description": "Danh sách media attachments",
                "items": {
                    "$ref": "#/definitions/ChatMedia"
                }
            },
            "reactions": {
                "type": "array",
                "description": "Danh sách reactions",
                "items": {
                    "$ref": "#/definitions/ChatReaction"
                }
            }
        },
        "required": [
            "id",
            "content",
            "user_id",
            "user_name",
            "course_id",
            "created_at"
        ]
    },
    "ChatReply": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "description": "ID của reply",
                "example": 456
            },
            "content": {
                "type": "string",
                "description": "Nội dung reply",
                "example": "Thanks for sharing!"
            },
            "user_id": {
                "type": "integer",
                "description": "ID của người reply",
                "example": 487
            },
            "user_name": {
                "type": "string",
                "description": "Tên người reply",
                "example": "Jane Smith"
            },
            "parent_message_id": {
                "type": "integer",
                "description": "ID của tin nhắn cha",
                "example": 123
            },
            "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian tạo",
                "example": "2025-09-11T16:55:00Z"
            },
            "medias": {
                "type": "array",
                "description": "Danh sách media attachments",
                "items": {
                    "$ref": "#/definitions/ChatMedia"
                }
            }
        },
        "required": [
            "id",
            "content",
            "user_id",
            "user_name",
            "parent_message_id",
            "created_at"
        ]
    },
    "ChatMedia": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "description": "ID của media",
                "example": 789
            },
            "name": {
                "type": "string",
                "description": "Tên file",
                "example": "image.jpg"
            },
            "type": {
                "type": "string",
                "description": "MIME type",
                "example": "image/jpeg"
            },
            "size": {
                "type": "integer",
                "description": "Kích thước file (bytes)",
                "example": 1024000
            },
            "url": {
                "type": "string",
                "description": "URL để truy cập file",
                "example": "https://domain.com/uploads/image.jpg"
            },
            "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian upload",
                "example": "2025-09-11T16:50:00Z"
            }
        },
        "required": [
            "id",
            "name",
            "type",
            "size",
            "url",
            "created_at"
        ]
    },
    "ChatReaction": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "description": "ID của reaction",
                "example": 101
            },
            "emoji": {
                "type": "string",
                "description": "Emoji reaction",
                "example": "👍"
            },
            "user_id": {
                "type": "integer",
                "description": "ID của người react",
                "example": 485
            },
            "user_name": {
                "type": "string",
                "description": "Tên người react",
                "example": "John Doe"
            },
            "message_id": {
                "type": "integer",
                "description": "ID của tin nhắn",
                "example": 123
            },
            "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian react",
                "example": "2025-09-11T16:52:00Z"
            }
        },
        "required": [
            "id",
            "emoji",
            "user_id",
            "user_name",
            "message_id",
            "created_at"
        ]
    },
    "SendChatMessageRequest": {
        "type": "object",
        "properties": {
            "content": {
                "type": "string",
                "description": "Nội dung tin nhắn",
                "example": "Hello everyone!",
                "minLength": 1,
                "maxLength": 10000
            },
            "course_id": {
                "type": "integer",
                "description": "ID của course",
                "example": 102
            },
            "media_ids": {
                "type": "array",
                "description": "Danh sách ID của media đã upload",
                "items": {
                    "type": "integer"
                },
                "example": [
                    789,
                    790
                ]
            }
        },
        "required": [
            "content",
            "course_id"
        ]
    },
    "SendChatReplyRequest": {
        "type": "object",
        "properties": {
            "content": {
                "type": "string",
                "description": "Nội dung reply",
                "example": "Thanks for sharing!",
                "minLength": 1,
                "maxLength": 10000
            },
            "parent_message_id": {
                "type": "integer",
                "description": "ID của tin nhắn cha",
                "example": 123
            },
            "course_id": {
                "type": "integer",
                "description": "ID của course",
                "example": 102
            },
            "media_ids": {
                "type": "array",
                "description": "Danh sách ID của media đã upload",
                "items": {
                    "type": "integer"
                },
                "example": [
                    791
                ]
            }
        },
        "required": [
            "content",
            "parent_message_id",
            "course_id"
        ]
    },
    "AddReactionRequest": {
        "type": "object",
        "properties": {
            "emoji": {
                "type": "string",
                "description": "Emoji để react",
                "example": "👍",
                "pattern": "^[\\p{Emoji}]$"
            }
        },
        "required": [
            "emoji"
        ]
    },
    "RemoveReactionRequest": {
        "type": "object",
        "properties": {
            "emoji": {
                "type": "string",
                "description": "Emoji để xóa reaction",
                "example": "👍",
                "pattern": "^[\\p{Emoji}]$"
            }
        },
        "required": [
            "emoji"
        ]
    },
    "ChatMessagesResponse": {
