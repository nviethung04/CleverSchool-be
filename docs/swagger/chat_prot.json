    "ActiveChannelsResponse": {
        "type": "object",
        "properties": {
            "code": {
                "type": "integer",
                "example": 200
            },
            "message": {
                "type": "string",
                "example": "success"
            },
            "data": {
                "type": "object",
                "properties": {
                    "channels": {
                        "type": "array",
                        "description": "Danh sách active Redis channels",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "chat:course:102",
                            "chat:course:103",
                            "chat:user:485"
                        ]
                    }
                }
            },
            "error": {
                "type": "string",
                "example": ""
            }
        }
    },
    "ChannelStatsResponse": {
        "type": "object",
        "properties": {
            "code": {
                "type": "integer",
                "example": 200
            },
            "message": {
                "type": "string",
                "example": "success"
            },
            "data": {
                "type": "object",
                "properties": {
                    "channels": {
                        "type": "array",
                        "description": "Danh sách channels",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "chat:course:102",
                            "chat:course:103"
                        ]
                    },
                    "subscriber_counts": {
                        "type": "object",
                        "description": "Số lượng subscribers cho mỗi channel",
                        "example": {
                            "chat:course:102": 15,
                            "chat:course:103": 8
                        }
                    },
                    "total_channels": {
                        "type": "integer",
                        "description": "Tổng số channels active",
                        "example": 2
                    }
                }
            },
            "error": {
                "type": "string",
                "example": ""
            }
        }
    },
    "SSEEventData": {
        "type": "object",
        "description": "Cấu trúc dữ liệu SSE event",
        "properties": {
            "type": {
                "type": "string",
                "description": "Loại event",
                "enum": [
                    "connected",
                    "message",
                    "reply",
                    "reaction",
                    "pin",
                    "delete",
                    "heartbeat"
                ],
                "example": "message"
            },
            "message_id": {
                "type": "integer",
                "description": "ID của message (nếu có)",
                "example": 123
            },
            "user_id": {
                "type": "integer",
                "description": "ID của user (nếu có)",
                "example": 485
            },
            "course_id": {
                "type": "integer",
                "description": "ID của course (nếu có)",
                "example": 102
            },
            "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "Thời gian event",
                "example": "2025-09-11T16:50:00Z"
            },
            "data": {
                "type": "object",
                "description": "Dữ liệu cụ thể của event",
                "properties": {
                    "message": {
                        "$ref": "#/definitions/ChatMessage"
                    },
                    "reply": {
                        "$ref": "#/definitions/ChatReply"
                    },
                    "reaction": {
                        "$ref": "#/definitions/ChatReaction"
                    },
                    "is_pinned": {
                        "type": "boolean"
                    },
                    "action": {
                        "type": "string"
                    },
                    "emoji": {
                        "type": "string"
                    },
                    "reaction_count": {
                        "type": "integer"
                    },
                    "user_name": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "parent_message_id": {
                        "type": "integer"
                    }
                }
            }
        },
        "required": [
            "type",
            "timestamp"
        ]
    },
    "ErrorResponse": {
        "type": "object",
        "properties": {
            "code": {
                "type": "integer",
                "example": 400
            },
            "message": {
                "type": "string",
                "example": "Bad Request"
            },
            "data": {
                "type": "object",
                "nullable": true
            },
            "error": {
                "type": "string",
                "description": "Chi tiết lỗi",
                "example": "Invalid course ID"
            }
        }
    },
    "RecentSender": {
        "type": "object",
        "description": "Thông tin người gửi tin nhắn gần đây kèm tin nhắn cuối cùng",
        "properties": {
            "sender": {
                "$ref": "#/definitions/ChatUserResponse",
                "description": "Thông tin người gửi"
            },
            "last_message": {
                "$ref": "#/definitions/ChatMessage",
                "description": "Tin nhắn cuối cùng từ người gửi này"
            }
        },
        "required": [
            "sender",
            "last_message"
        ]
    },
    "ChatUserResponse": {
        "type": "object",
        "properties": {
            "id": {
                "type": "integer",
                "description": "ID của user",
                "example": 485
            },
            "username": {
                "type": "string",
                "description": "Username",
                "example": "john_doe"
            },
            "full_name": {
                "type": "string",
                "description": "Tên đầy đủ",
                "example": "John Doe"
            },
            "avatar": {
                "type": "string",
                "description": "URL avatar",
                "example": "https://domain.com/uploads/avatar.jpg"
            }
        },
        "required": [
            "id",
            "username",
            "full_name"
        ]
    },
    "RecentSendersResponse": {
        "type": "object",
        "properties": {
            "code": {
                "type": "integer",
                "example": 200
            },
            "message": {
                "type": "string",
                "example": "success"
            },
            "data": {
                "type": "object",
                "properties": {
                    "senders": {
                        "type": "array",
                        "description": "Danh sách người gửi tin nhắn gần đây",
                        "items": {
                            "$ref": "#/definitions/RecentSender"
                        }
                    },
                    "count": {
                        "type": "integer",
                        "description": "Số lượng người gửi",
                        "example": 5
                    }
                }
            },
            "error": {
                "type": "string",
                "example": ""
            }
        }
    }
}