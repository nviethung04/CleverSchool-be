    },
    "delete": {
      "summary": "Xóa tiêu chí đánh giá",
      "description": "API để xóa tiêu chí",
      "tags": [
        "Assessment Criteria"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        }
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "$ref": "#/parameters/AcceptHeader"
        },
        {
          "$ref": "#/parameters/LocaleHeader"
        },
        {
          "in": "path",
          "name": "id",
          "required": true,
          "type": "integer",
          "description": "ID của tiêu chí"
        }
      ],
      "responses": {
        "200": {
          "description": "Xóa thành công"
        }
      }
    }
  }
