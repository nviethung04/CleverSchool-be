  "prot.UpdatePublishAssessmentResponse": {
    "type": "object",
    "properties": {
      "course_id": {
        "type": "integer",
        "format": "int64"
      },
      "assessment_id": {
        "type": "integer",
        "format": "int64"
      },
      "publish_course_ids": {
        "type": "array",
        "items": {
          "type": "integer",
          "format": "int64"
        }
