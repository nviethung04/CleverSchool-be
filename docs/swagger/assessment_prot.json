        "type": "integer",
        "format": "int64"
      },
      "assessment_id": {
        "type": "integer",
        "format": "int64"
      },
      "publish": {
        "type": "boolean"
      }
    }
  },
  "prot.UpdatePublishAssessmentRequest": {
