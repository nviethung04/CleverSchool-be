{
  "/api/manage/course-schedule/assign-parent": {
    "post": {
      "description": "API gán khóa cha cho một khóa học hiện tại và copy toàn bộ lesson_schedules từ khóa cha sang khóa con. Yêu cầu khóa cha phải là root (parent_course_id = 0) và hai khóa cùng program_id.",
      "consumes": [
        "application/json"
      ],
      "produces": [
        "application/json"
      ],
      "tags": [
        "Course Schedule"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/parameters/AcceptHeader"
        },
        {
          "$ref": "#/parameters/LocaleHeader"
        },
        {
          "in": "body",
          "name": "payload",
          "description": "Thông tin khóa hiện tại và khóa cha",
          "required": true,
          "schema": {
            "$ref": "#/definitions/prot.AssignCourseParentRequest"
          }
        }
      ],
      "summary": "Gán khóa cha và copy lịch học",
      "responses": {
        "200": {
          "description": "Thành công",
          "schema": {
            "$ref": "#/definitions/prot.CourseScheduleActionResponse"
          }
        },
        "400": {
          "description": "Yêu cầu không hợp lệ",
          "schema": {
            "$ref": "#/definitions/ErrorResponse"
          }
        },
        "401": {
          "description": "Không có quyền",
          "schema": {
            "$ref": "#/definitions/ErrorResponse"
          }
        },
        "500": {
          "description": "Lỗi hệ thống",
          "schema": {
            "$ref": "#/definitions/ErrorResponse"
          }
        }
      }
    }
  },
  "/api/manage/course-schedule/family": {
    "get": {
      "description": "Lấy thông tin gia đình khóa học gồm khóa cha (nếu có) và danh sách khóa con dựa trên course_id truyền vào.",
      "produces": [
        "application/json"
      ],
      "tags": [
        "Course Schedule"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/parameters/AcceptHeader"
        },
        {
          "$ref": "#/parameters/LocaleHeader"
        },
        {
          "in": "query",
          "name": "course_id",
          "description": "ID của khóa học cần truy vấn gia đình",
          "required": true,
          "type": "integer",
          "format": "int64"
        }
      ],
      "summary": "Lấy gia đình khóa học",
      "responses": {
        "200": {
          "description": "Thành công",
          "schema": {
            "$ref": "#/definitions/prot.CourseFamilyResponse"
          }
        },
        "400": {
          "description": "Yêu cầu không hợp lệ",
          "schema": {
            "$ref": "#/definitions/ErrorResponse"
          }
        },
        "404": {
          "description": "Không tìm thấy khóa học",
          "schema": {
            "$ref": "#/definitions/ErrorResponse"
          }
        }
      }
    }
  },
  "/api/manage/course-schedule/sync-all-family": {
    "post": {
      "description": "Đồng bộ lịch học hiện tại của khóa được chọn tới toàn bộ khóa trong cùng family (bao gồm khóa cha và các khóa con).",
      "consumes": [
        "application/json"
      ],
      "produces": [
        "application/json"
      ],
      "tags": [
        "Course Schedule"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        }
      ],
      "parameters": [
        {
          "$ref": "#/parameters/AcceptHeader"
        },
        {
          "$ref": "#/parameters/LocaleHeader"
        },
        {
          "in": "body",
          "name": "payload",
          "description": "Khóa nguồn cần đồng bộ",
          "required": true,
          "schema": {
            "$ref": "#/definitions/prot.CourseFamilySyncRequest"
          }
        }
      ],
      "summary": "Đồng bộ lịch học cả family",
      "responses": {
        "200": {
          "description": "Thành công",
          "schema": {
            "$ref": "#/definitions/prot.CourseFamilySyncResponse"
          }
        },
        "400": {
          "description": "Yêu cầu không hợp lệ hoặc family không có khóa nào để đồng bộ",
          "schema": {
            "$ref": "#/definitions/ErrorResponse"
          }
        },
        "500": {
          "description": "Lỗi hệ thống",
          "schema": {
            "$ref": "#/definitions/ErrorResponse"
          }
        }
      }
    }
  }
}

