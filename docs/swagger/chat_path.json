{
    "/api/manage/courses/{id}/chat/events": {
        "get": {
            "description": "Server-Sent Events endpoint để nhận real-time chat events cho course",
            "produces": [
                "text/event-stream"
            ],
            "tags": [
                "Chat SSE"
            ],
            "parameters": [
                {
                    "type": "integer",
                    "description": "Course ID",
                    "name": "id",
                    "in": "path",
                    "required": true
                },
                {
                    "type": "string",
                    "description": "JWT Authentication Token",
                    "name": "token",
                    "in": "query",
                    "required": true
                }
            ],
            "responses": {
                "200": {
                    "description": "SSE stream với các events: connected, message, reply, reaction, pin, delete, heartbeat",
                    "schema": {
                        "type": "string",
                        "example": "event: connected\\ndata: {\"course_id\": 1, \"user_id\": 485, \"timestamp\": \"2025-09-11T16:49:53+07:00\"}\\n\\nevent: message\\ndata: {\"type\": \"message\", \"message_id\": 123, \"data\": {...}}\\n\\n"
                    }
                },
                "401": {
                    "description": "Unauthorized - Token không hợp lệ",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "400": {
                    "description": "Bad Request - Course ID không hợp lệ",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
    "/api/manage/courses/{id}/chat/messages": {
        "get": {
            "description": "Lấy danh sách tin nhắn trong course chat",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Chat Messages"
            ],
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "type": "integer",
                    "description": "Course ID",
                    "name": "id",
                    "in": "path",
                    "required": true
                },
                {
                    "type": "integer",
                    "description": "Số trang (mặc định: 1)",
                    "name": "page",
                    "in": "query",
                    "default": 1
                },
                {
                    "type": "integer",
                    "description": "Số lượng message mỗi trang (mặc định: 20, tối đa: 100)",
                    "name": "limit",
                    "in": "query",
                    "default": 20
                }
            ],
            "responses": {
                "200": {
                    "description": "Danh sách tin nhắn",
                    "schema": {
                        "$ref": "#/definitions/ChatMessagesResponse"
                    }
                },
                "400": {
                    "description": "Bad Request",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        },
        "post": {
            "description": "Gửi tin nhắn mới với media attachments",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Chat Messages"
            ],
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "type": "integer",
                    "description": "Course ID",
                    "name": "id",
                    "in": "path",
                    "required": true
                },
                {
                    "description": "Dữ liệu tin nhắn",
                    "name": "body",
                    "in": "body",
                    "required": true,
                    "schema": {
                        "$ref": "#/definitions/SendChatMessageRequest"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Tin nhắn đã được gửi",
                    "schema": {
                        "$ref": "#/definitions/ChatMessageResponse"
                    }
                },
                "400": {
                    "description": "Bad Request - Dữ liệu không hợp lệ",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "500": {
                    "description": "Internal Server Error",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
