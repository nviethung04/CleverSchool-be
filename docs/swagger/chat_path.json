{
    "/ws/chat": {
        "get": {
            "description": "WebSocket endpoint để kết nối real-time chat. Upgrade HTTP connection to WebSocket.",
            "produces": [
                "application/json"
            ],
            "tags": [
                "Chat WebSocket"
            ],
            "parameters": [
                {
                    "type": "string",
                    "description": "JWT Authentication Token",
                    "name": "token",
                    "in": "query",
                    "required": true
                },
                {
                    "type": "integer",
                    "description": "Course ID",
                    "name": "course_id",
                    "in": "query",
                    "required": true
                }
            ],
            "responses": {
                "101": {
                    "description": "Switching Protocols - WebSocket connection established"
                },
                "400": {
                    "description": "Bad Request - Missing token or course_id, or invalid course_id",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized - Invalid token",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
    "/api/manage/ws/stats": {
        "get": {
            "description": "Lấy thống kê WebSocket connections",
            "produces": [
                "application/json"
            ],
            "tags": [
                "Chat WebSocket"
            ],
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "type": "integer",
                    "description": "Course ID (optional)",
                    "name": "course_id",
                    "in": "query",
                    "required": false
                }
            ],
            "responses": {
                "200": {
                    "description": "Thống kê WebSocket connections",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "string",
                                "example": "WebSocket hub running"
                            },
                            "course_id": {
                                "type": "integer",
                                "example": 1
                            },
                            "client_count": {
                                "type": "integer",
                                "example": 5
                            },
                            "online_users": {
                                "type": "array",
                                "items": {
                                    "type": "integer"
                                },
                                "example": [485, 486, 487]
                            }
                        }
                    }
                },
                "400": {
                    "description": "Bad Request",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
    "/api/manage/courses/{id}/ws/online-users": {
        "get": {
            "description": "Lấy danh sách users đang online trong course",
            "produces": [
                "application/json"
            ],
            "tags": [
                "Chat WebSocket"
            ],
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "type": "integer",
                    "description": "Course ID",
                    "name": "id",
                    "in": "path",
                    "required": true
                }
            ],
            "responses": {
                "200": {
                    "description": "Danh sách users online",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "course_id": {
                                "type": "integer",
                                "example": 1
                            },
                            "online_users": {
                                "type": "array",
                                "items": {
                                    "type": "integer"
                                },
                                "example": [485, 486, 487]
                            },
                            "count": {
                                "type": "integer",
                                "example": 3
                            }
                        }
                    }
                },
                "400": {
                    "description": "Bad Request - Invalid course ID",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
    "/api/manage/courses/{id}/chat/messages": {
        "get": {
            "description": "Lấy danh sách tin nhắn trong course chat",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Chat Messages"
            ],
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "type": "integer",
                    "description": "Course ID",
                    "name": "id",
                    "in": "path",
                    "required": true
                },
                {
                    "type": "integer",
                    "description": "Số trang (mặc định: 1)",
                    "name": "page",
                    "in": "query",
                    "default": 1
                },
                {
                    "type": "integer",
                    "description": "Số lượng message mỗi trang (mặc định: 20, tối đa: 100)",
                    "name": "limit",
                    "in": "query",
                    "default": 20
                }
            ],
            "responses": {
                "200": {
                    "description": "Danh sách tin nhắn",
                    "schema": {
                        "$ref": "#/definitions/ChatMessagesResponse"
                    }
                },
                "400": {
                    "description": "Bad Request",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        },
        "post": {
            "description": "Gửi tin nhắn mới với media attachments. Hỗ trợ cả JSON và multipart/form-data.",
            "consumes": [
                "application/json",
                "multipart/form-data"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Chat Messages"
            ],
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "type": "integer",
                    "description": "Course ID",
                    "name": "id",
                    "in": "path",
                    "required": true
                },
                {
                    "description": "Dữ liệu tin nhắn (JSON) hoặc form data với 'content' và 'files'/'file'",
                    "name": "body",
                    "in": "body",
                    "required": true,
                    "schema": {
                        "$ref": "#/definitions/SendChatMessageRequest"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Tin nhắn đã được gửi",
                    "schema": {
                        "$ref": "#/definitions/ChatMessageResponse"
                    }
                },
                "400": {
                    "description": "Bad Request - Dữ liệu không hợp lệ hoặc message rỗng",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "500": {
                    "description": "Internal Server Error",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
