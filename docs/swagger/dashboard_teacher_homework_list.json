{
  "/api/dashboard/teacher/homework/list-homeworks": {
    "get": {
      "summary": "Danh sách homework của học sinh",
      "description": "API để lấy danh sách homework được assigned cho student trong course với trạng thái hoàn thành, số câu đã làm/tổng số câu, và thời gian submit",
      "tags": [
        "Dashboard Teacher Homework"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        }
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "$ref": "#/parameters/AcceptHeader"
        },
        {
          "$ref": "#/parameters/LocaleHeader"
        },
        {
          "in": "query",
          "name": "course_id",
          "description": "ID khóa học (bắt buộc)",
          "required": true,
          "type": "integer"
        },
        {
          "in": "query",
          "name": "student_id",
          "description": "ID học sinh (tùy chọn - filter theo học sinh cụ thể)",
          "required": false,
          "type": "integer"
        },
        {
          "in": "query",
          "name": "chapter_id",
          "description": "Lọc theo ID chương",
          "required": false,
          "type": "integer"
        },
        {
          "in": "query",
          "name": "lesson_id",
          "description": "Lọc theo ID bài học",
          "required": false,
          "type": "integer"
        },
        {
          "in": "query",
          "name": "lesson_ids",
          "description": "Danh sách ID bài học (cách nhau bởi dấu phẩy, VD: 1,2,3)",
          "required": false,
          "type": "string"
        },
        {
          "in": "query",
          "name": "homework_ids",
          "description": "Danh sách ID homework (cách nhau bởi dấu phẩy, VD: 1,2,3)",
          "required": false,
          "type": "string"
        },
        {
          "in": "query",
          "name": "start_date",
          "description": "Ngày bắt đầu (định dạng YYYY-MM-DD hoặc Unix timestamp)",
          "required": false,
          "type": "string"
        },
        {
          "in": "query",
          "name": "end_date",
          "description": "Ngày kết thúc (định dạng YYYY-MM-DD hoặc Unix timestamp)",
          "required": false,
          "type": "string"
        },
        {
          "in": "query",
          "name": "page",
          "description": "Số trang",
          "required": false,
          "type": "integer"
        },
        {
          "in": "query",
          "name": "limit",
          "description": "Số lượng mỗi trang",
          "required": false,
          "type": "integer"
        },
        {
          "in": "query",
          "name": "order_by",
          "description": "Sắp xếp theo (completed_homework hoặc average_score)",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "description": "Thành công",
          "schema": {
            "$ref": "#/definitions/prot.DashboardTeacherHomeworkListResponse"
          }
        }
      }
    }
  }
}

