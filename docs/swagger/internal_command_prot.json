{
    "InternalCommandResponse": {
        "type": "object",
        "properties": {
            "message": {
                "type": "string",
                "description": "Success message"
            },
            "total_updated": {
                "type": "integer",
                "description": "Total number of records updated"
            },
            "results": {
                "type": "object",
                "description": "Detailed results for each table",
                "additionalProperties": {
                    "type": "object",
                    "properties": {
                        "status": {
                            "type": "string",
                            "enum": ["success", "skipped", "error"],
                            "description": "Status of the operation for this table"
                        },
                        "message": {
                            "type": "string",
                            "description": "Status message"
                        },
                        "updated": {
                            "type": "integer",
                            "description": "Number of records updated in this table"
                        }
                    }
                }
            }
        }
    },
    "CopyHomeworkToExerciseResponse": {
        "type": "object",
        "properties": {
            "message": {
                "type": "string",
                "example": "Homework copied to exercise successfully"
            },
            "copied_count": {
                "type": "integer",
                "example": 25,
                "description": "Number of homework records copied"
            }
        }
    },
    "ClearExerciseResponse": {
        "type": "object",
        "properties": {
            "message": {
                "type": "string",
                "example": "Exercise data cleared successfully"
            },
            "cleared_count": {
                "type": "integer",
                "example": 100,
                "description": "Number of exercise records cleared"
            }
        }
    },
    "SyncHomeworkStatusScoringResponse": {
        "type": "object",
        "properties": {
            "message": {
                "type": "string",
                "example": "Homework status scoring synced successfully"
            },
            "synced_count": {
                "type": "integer",
                "example": 200,
                "description": "Number of homework records synced"
            }
        }
    }
}
