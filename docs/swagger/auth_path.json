{
    "/api/register": {
        "post": {
            "description": "API để đăng ký tài khoản",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Auth"
            ],
            "summary": "Đăng ký tài khoản",
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "$ref": "#/parameters/LocaleHeader"
                },
                {
                    "in": "body",
                    "name": "user",
                    "description": "Thông tin tài khoản",
                    "required": true,
                    "schema": {
                        "$ref": "#/definitions/prot.RegisterRequest"
                    }
                }
            ],
            "responses": {
                "200": {
                    "Message": "success",
                    "schema": {
                        "$ref": "#/definitions/prot.User"
                    }
                }
            }
        }
    },
    "/api/login": {
        "post": {
            "description": "API để đăng nhập",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Auth"
            ],
            "summary": "Đăng nhập",
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "$ref": "#/parameters/LocaleHeader"
                },
                {
                    "in": "body",
                    "name": "credentials",
                    "description": "Thông tin đăng nhập (username và password)",
                    "required": true,
                    "schema": {
                        "type": "object",
                        "properties": {
                            "username": {
                                "type": "string",
                                "description": "Tên đăng nhập"
                            },
                            "password": {
                                "type": "string",
                                "description": "Mật khẩu"
                            }
                        },
                        "required": [
                            "username",
                            "password"
                        ]
                    }
                }
            ],
            "responses": {
                "200": {
                    "Message": "success",
                    "schema": {
                        "$ref": "#/definitions/prot.UserLoginResponse"
                    }
                }
            }
        }
    },
    "/api/accept-roles/{id}": {
        "put": {
            "description": "API để chọn vai trò",
            "consumes": [
                "application/json"
            ],
            "produces": [
                "application/json"
            ],
            "tags": [
                "Auth"
            ],
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "summary": "Chọn vai trò",
            "parameters": [
                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "$ref": "#/parameters/LocaleHeader"
                },
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "type": "integer",
                    "format": "uint64",
                    "description": "ID của vai trò"
                }
            ],
            "responses": {
                "200": {
                    "Message": "success",
                    "schema": {
                        "$ref": "#/definitions/prot.UserLoginResponse"
                    }
                }
            }
        }
    },
