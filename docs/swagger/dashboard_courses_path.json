{
  "paths": {
    "/api/dashboard/report/courses": {
      "get": {
        "tags": ["Dashboard Courses"],
        "summary": "Get dashboard courses with pagination, search, and date filtering",
        "description": "Retrieve a list of courses with statistics including total students, teachers, active users, and homework completion data. Supports pagination, search, filtering by school, and date range.",
        "parameters": [
          {
            "name": "school_id",
            "in": "query",
            "description": "Filter by school ID (optional)",
            "required": false,
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search by course name or school name (case-insensitive)",
            "required": false,
            "type": "string",
            "example": "toán"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 1, or all data if not provided)",
            "required": false,
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page (default: 10, or all data if not provided)",
            "required": false,
            "type": "integer",
            "minimum": 1,
            "example": 10
          },
          {
            "name": "start_date",
            "in": "query",
            "description": "Selected week start date (Unix timestamp)",
            "required": false,
            "type": "integer",
            "format": "int64",
            "example": 1736899200
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "Selected week end date (Unix timestamp)",
            "required": false,
            "type": "integer",
            "format": "int64",
            "example": 1737504000
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/DashboardCoursesResponseSchema"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid school_id format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard/report/courses/export": {
      "get": {
        "tags": ["Dashboard Courses"],
        "summary": "Export dashboard courses to Excel with date filtering",
        "description": "Export all courses data to Excel file (.xlsx) with statistics including total students, teachers, active users, and homework completion data. Supports filtering by school and date range.",
        "parameters": [
          {
            "name": "school_id",
            "in": "query",
            "description": "Filter by school ID (optional)",
            "required": false,
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          {
            "name": "start_date",
            "in": "query",
            "description": "Selected week start date (Unix timestamp)",
            "required": false,
            "type": "integer",
            "format": "int64",
            "example": 1736899200
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "Selected week end date (Unix timestamp)",
            "required": false,
            "type": "integer",
            "format": "int64",
            "example": 1737504000
          }
        ],
        "responses": {
          "200": {
            "description": "Excel file download",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Content-Disposition": {
                "description": "Attachment filename",
                "schema": {
                  "type": "string",
                  "example": "attachment; filename=dashboard_courses.xlsx"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid school_id format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DashboardReportCourseSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Course record ID"
        },
        "course_id": {
          "type": "integer",
          "format": "int64",
          "description": "Course ID"
        },
        "course_name": {
          "type": "string",
          "description": "Course name"
        },
        "school_id": {
          "type": "integer",
          "format": "int64",
          "description": "School ID"
        },
        "school_name": {
          "type": "string",
          "description": "School name"
        },
        "total_students": {
          "type": "integer",
          "format": "int64",
          "description": "Total number of students in the course"
        },
        "total_teachers": {
          "type": "integer",
          "format": "int64",
          "description": "Total number of teachers in the course"
        },
        "teacher_ids": {
          "type": "string",
          "description": "Comma-separated list of teacher IDs"
        },
        "teacher_infos": {
          "type": "array",
          "description": "Array of teacher information objects",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64",
                "description": "Teacher ID"
              },
              "username": {
                "type": "string",
                "description": "Teacher username"
              },
              "name": {
                "type": "string",
                "description": "Teacher name"
              }
            }
          }
        },
        "active_teachers_from_sep8": {
          "type": "integer",
          "format": "int64",
          "description": "Number of active teachers from September 8, 2025"
        },
        "active_students_from_sep15": {
          "type": "integer",
          "format": "int64",
          "description": "Number of active students from September 15, 2025"
        },
        "students_completed_homework_from_sep15": {
          "type": "integer",
          "format": "int64",
          "description": "Number of students who completed homework from September 15, 2025"
        },
        "students_completed_homework_last_week": {
          "type": "integer",
          "format": "int64",
          "description": "Number of students who completed homework in the last week (-1 if no data)"
        },
        "active_students_last_week": {
          "type": "integer",
          "format": "int64",
          "description": "Number of active students in the last week (-1 if no data)"
        },
        "active_teachers_last_week": {
          "type": "integer",
          "format": "int64",
          "description": "Number of active teachers in the last week (-1 if no data)"
        }
      }
    },
    "DashboardCoursesResponseSchema": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "description": "Response code"
        },
        "data": {
          "type": "object",
          "properties": {
            "courses": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DashboardReportCourseSchema"
              }
            },
            "total": {
              "type": "integer",
              "format": "int64",
              "description": "Total number of courses"
            },
            "page": {
              "type": "integer",
              "description": "Current page number"
            },
            "limit": {
              "type": "integer",
              "description": "Items per page"
            },
            "total_pages": {
              "type": "integer",
              "description": "Total number of pages"
            }
          }
        },
        "message": {
          "type": "string",
          "description": "Response message"
        }
      }
    }
  }
}
