{
  "/api/dashboard/course-list": {
    "get": {
      "tags": ["Dashboard List"],
      "summary": "Get dashboard course list",
      "description": "Trả về danh sách khóa học phục vụ dashboard. Có thể lọc theo trường, chương trình, môn học hoặc parent_course_id (0 hoặc không truyền sẽ lấy tất cả).",
      "parameters": [
        {
          "name": "page",
          "in": "query",
          "description": "Trang hiện tại (mặc định 1)",
          "required": false,
          "type": "integer",
          "minimum": 1,
          "example": 1
        },
        {
          "name": "limit",
          "in": "query",
          "description": "Số phần tử mỗi trang (mặc định 10)",
          "required": false,
          "type": "integer",
          "minimum": 1,
          "example": 10
        },
        {
          "name": "school_id",
          "in": "query",
          "description": "Lọc theo trường",
          "required": false,
          "type": "integer",
          "format": "int64",
          "example": 5
        },
        {
          "name": "program_id",
          "in": "query",
          "description": "Lọc theo chương trình",
          "required": false,
          "type": "integer",
          "format": "int64",
          "example": 12
        },
        {
          "name": "subject_id",
          "in": "query",
          "description": "Lọc theo môn học",
          "required": false,
          "type": "integer",
          "format": "int64",
          "example": 3
        },
        {
          "name": "parent_course_id",
          "in": "query",
          "description": "Lọc theo khóa học cha. Cho phép truyền 0 hoặc bỏ qua để lấy tất cả",
          "required": false,
          "type": "integer",
          "format": "int64",
          "example": 0
        }
      ],
      "responses": {
        "200": {
          "description": "Success",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/definitions/DashboardCourseListResponseSchema"
              }
            }
          }
        },
        "500": {
          "description": "Internal Server Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/definitions/ErrorResponse"
              }
            }
          }
        }
      }
    }
  },
