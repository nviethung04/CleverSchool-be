                {
                    "$ref": "#/parameters/AcceptHeader"
                },
                {
                    "$ref": "#/parameters/LocaleHeader"
                },
                {
                    "in": "body",
                    "name": "course",
                    "description": "Thông tin khóa học",
                    "required": true,
                    "schema": {
                        "$ref": "#/definitions/prot.CourseRequest"
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Tạo khóa học thành công",
                    "schema": {
                        "$ref": "#/definitions/prot.CourseDetail"
                    }
                }
            }
        }
    },
