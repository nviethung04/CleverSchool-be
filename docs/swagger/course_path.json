                },
                {
                    "$ref": "#/parameters/LocaleHeader"
                },
                {
                    "in": "query",
                    "name": "status",
                    "description": "Lấy theo trạng thái khóa học (1, 0)",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "school_id",
                    "description": "Lấy theo ID trường (0, 1, 2,..)",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "by_user",
                    "description": "Lấy theo tài khoản hiện tại",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "keyword",
                    "description": "Tìm kiếm từ khoá",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "parent_id",
                    "description": "Lấy theo id khóa gốc",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "sort_id",
                    "description": "Sắp xếp theo id (asc, desc)",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "sort_created_at",
                    "description": "Sắp xếp theo ngày tạo (newest, oldest)",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "page",
                    "description": "Lấy theo page",
                    "required": false
                },
                {
                    "in": "query",
                    "name": "per_page",
                    "description": "Số lượng items trên trang",
                    "required": false
