                "200": {
                    "description": "Thành công",
                    "schema": {
                        "$ref": "#/definitions/prot.CourseListResponse"
                    }
                }
            }
        },
        "post": {
            "description": "API để tạo khóa học mới. Có thể copy lịch học từ course khác bằng cách truyền target_course_id > 0",
