    "/api/internal/command/sync-homework-user-questions": {
        "post": {
            "tags": ["Internal Commands"],
            "summary": "Sync homework_user_questions from homework_question_user_* tables (async)",
            "description": "Dispatch job to sync homework_user_questions from all homework_question_user_* tables. Job runs in background and this API returns immediately. Optionally filter by created_at range using start_date and/or end_date.",
            "operationId": "syncHomeworkUserQuestions",
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "in": "body",
                    "name": "body",
                    "required": false,
                    "schema": {
                        "type": "object",
                        "properties": {
                            "start_date": {
                                "type": "string",
                                "format": "date",
                                "example": "2025-01-01",
                                "description": "Optional. Only sync records with created_at >= start_date (YYYY-MM-DD)."
                            },
                            "end_date": {
                                "type": "string",
                                "format": "date",
                                "example": "2025-01-31",
                                "description": "Optional. Only sync records with created_at <= end_date (YYYY-MM-DD)."
                            }
                        }
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Job dispatched successfully",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "success": { "type": "boolean", "example": true },
                            "message": {
                                "type": "string",
                                "example": "Đã dispatch job SyncHomeworkUserQuestionsJob, job đang chạy nền"
                            },
                            "processed_at": {
                                "type": "string",
                                "example": "2025-01-06 10:00:00"
                            },
                            "job_type": {
                                "type": "string",
                                "example": "sync_homework_user_questions"
                            }
                        }
                    }
                },
                "400": {
                    "description": "Bad Request",
                    "schema": { "$ref": "#/definitions/ErrorResponse" }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": { "$ref": "#/definitions/ErrorResponse" }
                },
                "403": {
                    "description": "Forbidden - Insufficient permissions",
                    "schema": { "$ref": "#/definitions/ErrorResponse" }
                },
                "500": {
                    "description": "Internal Server Error",
                    "schema": { "$ref": "#/definitions/ErrorResponse" }
                }
            }
        }
    },
