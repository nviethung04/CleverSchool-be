{
    "/api/internal/command/copy-homework-to-exercise": {
        "post": {
            "tags": ["Internal Commands"],
            "summary": "Copy homework to exercise",
            "description": "Copy homework data to exercise system for internal processing",
            "operationId": "copyHomeworkToExercise",
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "Success",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "message": {
                                "type": "string",
                                "example": "Homework copied to exercise successfully"
                            },
                            "copied_count": {
                                "type": "integer",
                                "example": 25
                            }
                        }
                    }
                },
                "400": {
                    "description": "Bad Request",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "403": {
                    "description": "Forbidden - Insufficient permissions",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "500": {
                    "description": "Internal Server Error",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
