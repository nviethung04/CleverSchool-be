    "/api/internal/command/recalculate-homework-users-metrics": {
        "post": {
            "tags": ["Internal Commands"],
            "summary": "Tính lại metrics cho homework_users (async) - Logic y hệt submit homework",
            "description": "Dispatch job tính lại metrics (score, ratio, exp, star, is_completed, has_manual_scoring, status_scoring) cho các hàng trong bảng homework_users theo điều kiện. Áp dụng logic y hệt như submit homework (dùng CalculateHomeworkMetrics và lưu tất cả metrics). Job chạy async trong background và trả về ngay lập tức. Có thể filter theo created_at bằng start_date/end_date và chỉ xử lý những homework có score = 0 nếu only_homework_zero_score = true. Kết quả sẽ được ghi vào log.",
            "operationId": "recalculateHomeworkUsersMetrics",
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "parameters": [
                {
                    "name": "body",
                    "in": "body",
                    "required": false,
                    "schema": {
                        "type": "object",
                        "properties": {
                            "start_date": {
                                "type": "string",
                                "format": "date",
                                "example": "2025-01-01",
                                "description": "Ngày bắt đầu (YYYY-MM-DD), optional. Filter theo created_at của homework_users."
                            },
                            "end_date": {
                                "type": "string",
                                "format": "date",
                                "example": "2025-01-31",
                                "description": "Ngày kết thúc (YYYY-MM-DD), optional. Filter theo created_at của homework_users."
                            },
                            "only_homework_zero_score": {
                                "type": "boolean",
                                "example": false,
                                "description": "Nếu true, chỉ tính lại những homework có ratio = 0. Default: false."
                            }
                        }
                    }
                }
            ],
            "responses": {
                "200": {
                    "description": "Job được dispatch thành công",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "success": {
                                "type": "boolean",
                                "example": true
                            },
                            "message": {
                                "type": "string",
                                "example": "Đã dispatch job RecalculateHomeworkUsersMetricsJob, job đang chạy nền"
                            },
                            "processed_at": {
                                "type": "string",
                                "example": "2025-01-06 10:00:00"
                            },
                            "job_type": {
                                "type": "string",
                                "example": "recalculate_homework_users_metrics"
                            }
                        }
                    }
                },
                "400": {
                    "description": "Bad Request - Invalid date format or validation error",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "403": {
                    "description": "Forbidden - Insufficient permissions",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
