    "/api/internal/command/update-homework-lesson-ids": {
        "post": {
            "tags": ["Internal Commands"],
            "summary": "Update homework lesson IDs",
            "description": "Update lesson_id for all homework-related tables based on homework_ref_lessons table. If a homework_id has multiple lesson_ids, the one with the latest created_at will be used.",
            "operationId": "updateHomeworkLessonIds",
            "security": [
                {
                    "ApiKeyAuth": []
                }
            ],
            "responses": {
                "200": {
                    "description": "Success",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "message": {
                                "type": "string",
                                "example": "Update completed successfully"
                            },
                            "total_updated": {
                                "type": "integer",
                                "example": 150
                            },
                            "results": {
                                "type": "object",
                                "properties": {
                                    "homework_comments": {
                                        "type": "object",
                                        "properties": {
                                            "status": {
                                                "type": "string",
                                                "example": "success"
                                            },
                                            "message": {
                                                "type": "string",
                                                "example": "Updated successfully"
                                            },
                                            "updated": {
                                                "type": "integer",
                                                "example": 25
                                            }
                                        }
                                    },
                                    "homework_users": {
                                        "type": "object",
                                        "properties": {
                                            "status": {
                                                "type": "string",
                                                "example": "success"
                                            },
                                            "message": {
                                                "type": "string",
                                                "example": "Updated successfully"
                                            },
                                            "updated": {
                                                "type": "integer",
                                                "example": 50
                                            }
                                        }
                                    },
                                    "homework_question_users": {
                                        "type": "object",
                                        "properties": {
                                            "status": {
                                                "type": "string",
                                                "example": "success"
                                            },
                                            "message": {
                                                "type": "string",
                                                "example": "Updated successfully"
                                            },
                                            "updated": {
                                                "type": "integer",
                                                "example": 75
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "400": {
                    "description": "Bad Request",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "401": {
                    "description": "Unauthorized",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "403": {
                    "description": "Forbidden - Insufficient permissions",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                },
                "500": {
                    "description": "Internal Server Error",
                    "schema": {
                        "$ref": "#/definitions/ErrorResponse"
                    }
                }
            }
        }
    },
